# Copy to scripts/local.env (ignored by git) for your own defaults. install.sh reads it, --ipa never does.
# IRIS_MAC_REMOTE=http://<your-mac>:8081/<token>     # Iris Live on the Mac, the URL it prints at launch
# IRIS_OLLAMA_URL=http://<your-mac>:11434/v1         # the "Ollama sur le Mac" preset
# IRIS_OTA_HOST=<https host iOS downloads from>      # install.sh --ota
# IRIS_OTA_SSH=user@host                              # or "local"
